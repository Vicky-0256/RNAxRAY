{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rnaxray.org/schemas/rnaxray-result-1.0.json",
  "title": "RNAxRay analysis result envelope",
  "description": "Stable result envelope shared by web workers and native desktop tasks. Payload is versioned by kind.",
  "type": "object",
  "required": ["protocol_version", "result_id", "kind", "status", "inputs", "parameters", "provenance", "payload"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "result_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" },
    "kind": { "enum": ["interactions", "contact_map", "viewpoint", "compare", "structure", "cplfold", "report", "custom"] },
    "status": { "enum": ["complete", "partial", "failed"] },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" }, "uniqueItems": true },
    "parameters": { "type": "object", "additionalProperties": true },
    "provenance": { "$ref": "#/$defs/provenance" },
    "payload": { "type": "object", "additionalProperties": true },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "required": ["id", "format"],
      "properties": { "id": { "type": "string" }, "format": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["engine", "engine_version", "rules"],
      "properties": {
        "engine": { "type": "string" },
        "engine_version": { "type": "string" },
        "application_version": { "type": "string" },
        "runtime": { "enum": ["web", "desktop"] },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rules": { "type": "object", "required": ["bin_size", "colour_cap"], "properties": { "bin_size": { "const": 10 }, "colour_cap": { "const": "95" }, "coordinate_system": { "type": "string" } }, "additionalProperties": true }
      },
      "additionalProperties": false
    }
  }
}
